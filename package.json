    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.9",
